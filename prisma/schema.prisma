generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusOrdemServico {
  ABERTA
  EM_ANDAMENTO
  FINALIZADA
  ENTREGUE
  CANCELADA
}

enum FormaPagamento {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  TRANSFERENCIA
  OUTRO
}

enum TipoTransacao {
  ENTRADA
  SAIDA
}

model WorkshopSettings {
  id        Int      @id @default(autoincrement())
  nome      String   @default("Minha Oficina")
  cpfCnpj   String?
  telefone  String?
  whatsapp  String?
  endereco  String?
  cidade    String?
  estado    String?
  logoUrl   String?
  updatedAt DateTime @updatedAt

  @@map("workshop_settings")
}

model Customer {
  id          Int      @id @default(autoincrement())
  nome        String
  cpfCnpj     String?
  telefone    String?
  whatsapp    String?
  endereco    String?
  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]

  @@map("customers")
}

model Vehicle {
  id             Int      @id @default(autoincrement())
  customerId     Int
  placa          String   @unique
  marca          String
  modelo         String
  ano            Int?
  cor            String?
  quilometragem  Int?
  observacoes    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceOrders ServiceOrder[]

  @@map("vehicles")
}

model Service {
  id           Int      @id @default(autoincrement())
  nome         String
  descricao    String?
  valorPadrao  Decimal  @default(0) @db.Decimal(10, 2)
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  itensOrdem ServiceOrderService[]

  @@map("services")
}

model Product {
  id             Int      @id @default(autoincrement())
  nome           String
  codigo         String?  @unique
  marca          String?
  quantidade     Int      @default(0)
  estoqueMinimo  Int      @default(0)
  precoCusto     Decimal  @default(0) @db.Decimal(10, 2)
  precoVenda     Decimal  @default(0) @db.Decimal(10, 2)
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  itensOrdem          ServiceOrderProduct[]
  movimentosEstoque   StockMovement[]

  @@map("products")
}

model ServiceOrder {
  id                Int                 @id @default(autoincrement())
  data              DateTime            @default(now())
  customerId        Int
  vehicleId         Int
  quilometragem     Int?
  problemaInformado String?
  observacoes       String?
  formaPagamento    FormaPagamento      @default(PIX)
  desconto          Decimal             @default(0) @db.Decimal(10, 2)
  valorServicos     Decimal             @default(0) @db.Decimal(10, 2)
  valorPecas        Decimal             @default(0) @db.Decimal(10, 2)
  valorTotal        Decimal             @default(0) @db.Decimal(10, 2)
  valorPago         Decimal             @default(0) @db.Decimal(10, 2)
  status            StatusOrdemServico  @default(ABERTA)
  estoqueBaixado    Boolean             @default(false)
  finalizadaEm      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  servicos             ServiceOrderService[]
  pecas                ServiceOrderProduct[]
  pagamentos           Payment[]
  transacoesFinanceiro FinancialTransaction[]

  @@map("service_orders")
}

model ServiceOrderService {
  id             Int     @id @default(autoincrement())
  serviceOrderId Int
  serviceId      Int?
  descricao      String
  quantidade     Decimal @default(1) @db.Decimal(10, 2)
  valorUnitario  Decimal @default(0) @db.Decimal(10, 2)
  subtotal       Decimal @default(0) @db.Decimal(10, 2)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@map("service_order_services")
}

model ServiceOrderProduct {
  id             Int     @id @default(autoincrement())
  serviceOrderId Int
  productId      Int
  descricao      String
  quantidade     Decimal @default(1) @db.Decimal(10, 2)
  valorUnitario  Decimal @default(0) @db.Decimal(10, 2)
  subtotal       Decimal @default(0) @db.Decimal(10, 2)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("service_order_products")
}

model Payment {
  id             Int            @id @default(autoincrement())
  serviceOrderId Int
  valor          Decimal        @db.Decimal(10, 2)
  formaPagamento FormaPagamento
  data           DateTime       @default(now())
  createdAt      DateTime       @default(now())

  serviceOrder         ServiceOrder          @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  financialTransaction FinancialTransaction?

  @@map("payments")
}

model FinancialTransaction {
  id             Int            @id @default(autoincrement())
  tipo           TipoTransacao
  descricao      String
  valor          Decimal        @db.Decimal(10, 2)
  data           DateTime       @default(now())
  categoria      String
  serviceOrderId Int?
  paymentId      Int?           @unique
  createdAt      DateTime       @default(now())

  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  payment      Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@map("financial_transactions")
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  tipo      String
  quantidade Int
  motivo    String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}
